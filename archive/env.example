# ── AI Provider ───────────────────────────────────────────
# Switch between 'anthropic' and 'deepseek' — no code change needed
# Default when unset: anthropic
AI_PROVIDER=deepseek

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-REPLACE_ME

# ── Supabase ───────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJREPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# ── Calibration Thresholds (R11 — tunable without deploy) ──
# Leave unset to use heuristic defaults. Override in Railway Variables panel.
# Formal recalibration mandated at 100-session and 250-session corpus milestones.
# Use admin dashboard → Threshold Sensitivity section to inform each review.
MATCH_THRESHOLD=45
MIN_SESSIONS=5
PATTERNS_SESSION_THRESHOLD=3
RULES_SESSION_THRESHOLD=8
RERUN_DAYS_THRESHOLD=7
AVOIDANCE_DAYS_THRESHOLD=45
STRUCTURAL_ECHO_MIN_SCORE=60
